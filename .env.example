# Neon PostgreSQL — pooled connection string from your Neon dashboard
# Project > Connection Details > Connection string > Pooled
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# App URL — used for Stripe redirect URLs (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth — generate with: openssl rand -hex 32
AUTH_SECRET=""

# GitHub OAuth — create an OAuth app at github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend — create an API key at resend.com/api-keys
RESENT_API_KEY=""

# Email verification (true = enforce, false = bypass for local dev without a sending domain)
EMAIL_VERIFICATION_ENABLED=true

# Upstash Redis — create a database at upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

R2_ACCOUNT_ID=" "
R2_ACCESS_KEY_ID=" "
R2_SECRET_ACCESS_KEY=" "
R2_BUCKET_NAME=" "
R2_PUBLIC_URL=""

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=""
NEXT_PUBLIC_STRIPE_PRICE_ID_YEARLY=""

